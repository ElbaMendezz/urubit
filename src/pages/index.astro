---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/sections/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import Lab from '../components/sections/Lab.astro';
import Servicios from '../components/sections/Servicios.astro';
import Diferencia from '../components/sections/Diferencia.astro';
import Metodologia from '../components/sections/Metodologia.astro';
import Acompanamiento from '../components/sections/Acompanamiento.astro';
---

<BaseLayout title="Úrbit Lab">
  <Nav />
  <div class="hero-wrap">
    <Hero />
    <Lab />
  </div>
  <Servicios />
  <Diferencia />
  <Metodologia />
  <Acompanamiento />
  <!-- Sección Contacto: fase siguiente — ver /CLAUDE.md -->
</BaseLayout>

<style>
  .hero-wrap {
    position: relative;
    padding: 44px 22px 0;
  }

  @media (max-width: 1024px) {
    .hero-wrap {
      padding: 30px 16px 0;
    }
  }

  @media (max-width: 640px) {
    .hero-wrap {
      padding: 22px 12px 0;
    }
  }
</style>
