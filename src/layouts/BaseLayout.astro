---
import '../styles/global.css';
import { CONTACT } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}

// Title, description y keywords: copy SEO definitivo entregado por el
// cliente (ya no es provisional). Ver PENDIENTES.md — el og-image.png sigue
// siendo un placeholder, eso sí sigue pendiente de la pieza real.
// El title original del cliente medía 83 caracteres (máximo pedido: 65) —
// se acortó a 63 quitando "innovación social" del final, con las mismas
// palabras/orden que envió, sin agregar nada nuevo.
const DEFAULT_TITLE = 'ÚRBIT LAB | Arquitectura, urbanismo, ingeniería, sostenibilidad';
const DEFAULT_DESCRIPTION =
  'Diseñamos territorios y proyectos integrales desde la arquitectura, urbanismo, ingeniería y sostenibilidad para crear espacios más humanos y resilientes.';
const DEFAULT_KEYWORDS =
  'ÚRBIT LAB, arquitectura, urbanismo, ingeniería, diseño urbano, desarrollo territorial, planificación territorial, ordenamiento territorial, infraestructura, sostenibilidad, innovación social, arquitectura sostenible, urbanismo sostenible, vivienda de interés social, proyectos de infraestructura, gestión de proyectos, interventoría, innovación social, territorios resilientes';

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  keywords = DEFAULT_KEYWORDS,
} = Astro.props;

// Solo usa hechos ya establecidos en site.ts — sin inventar dirección,
// fecha de fundación ni logo (no hay URL estable de logo fuera de
// astro:assets). Ver PENDIENTES.md.
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ÚRBIT LAB',
  email: CONTACT.email,
  telephone: CONTACT.phoneHref.replace(/^tel:/, ''),
  sameAs: [CONTACT.instagramUrl],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@300;400;500;600;700;800&amp;family=Space+Mono:wght@400;700&amp;display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ÚRBIT LAB" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content="/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og-image.png" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} is:inline />
  </head>
  <body>
    <div id="top" class="page-shell">
      <slot />
    </div>

    <button id="back-to-top" type="button" class="back-to-top" aria-label="Volver arriba">↑</button>

    <script>
      import '../scripts/scroll-effects';
    </script>
  </body>
</html>

<style>
  .page-shell {
    width: 100%;
    background: var(--color-bg);
    color: var(--color-ink-800);
    overflow: hidden;
    position: relative;
  }

  .back-to-top {
    position: fixed;
    right: 26px;
    bottom: 26px;
    z-index: 60;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    border: none;
    cursor: pointer;
    background: var(--color-ink-800);
    color: var(--color-accent);
    font-size: 20px;
    line-height: 1;
    display: grid;
    place-items: center;
    box-shadow: 0 10px 30px rgba(22, 34, 27, 0.28);
    opacity: 0;
    transform: translateY(14px) scale(0.9);
    pointer-events: none;
    transition:
      opacity 300ms ease,
      transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .back-to-top:hover {
    background: var(--color-accent);
    color: var(--color-ink-900);
  }

  .back-to-top.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
</style>
