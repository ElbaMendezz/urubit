---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Úrbit Lab' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@300;400;500;600;700;800&amp;family=Space+Mono:wght@400;700&amp;display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <div id="top" class="page-shell">
      <slot />
    </div>
  </body>
</html>

<style>
  .page-shell {
    width: 100%;
    background: var(--color-bg);
    color: var(--color-ink-800);
    overflow: hidden;
    position: relative;
  }
</style>
