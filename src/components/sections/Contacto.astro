---
import { Image } from 'astro:assets';
import contactoCollage from '../../assets/contacto-collage.png';
import logoLight from '../../assets/logo-light.png';
import Cta from '../ui/Cta.astro';
import { CONTACT } from '../../data/site';
---

<section id="c-contacto" class="contacto-wrap">
  <div class="contacto-card">
    <Image
      src={contactoCollage}
      alt="Render de una calle urbana con arquitectura, ciclovía y espacio público arbolado"
      width={1894}
      height={830}
      widths={[828, 1668, 2206]}
      sizes="100vw"
      loading="lazy"
      class="contacto-bg"
    />
    <div class="contacto-veil"></div>
    <div class="contacto-glow"></div>

    <div class="head">
      <h2 class="head-title">¿Tiene un territorio por transformar?</h2>
      <Cta
        href={CONTACT.whatsappUrl}
        target="_blank"
        rel="noopener"
        background="var(--color-accent)"
        color="var(--color-ink-900)"
        hoverBackground="var(--color-bg)"
        hoverColor="var(--color-ink-900)"
        fontSize="17px"
        padding="22px 34px"
        class="contacto-cta"
      >
        Conversemos de tu proyecto →
      </Cta>
    </div>

    <footer class="footer-row">
      <Image src={logoLight} alt="Úrbit Lab (CLAP)" width={614} height={123} class="footer-logo" />

      <div class="footer-cols">
        <div class="footer-col">
          <span class="footer-col-label">CONTACTO</span>
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
          <a href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a>
        </div>
        <div class="footer-col">
          <span class="footer-col-label">REDES</span>
          <a href={CONTACT.instagramUrl}>INSTAGRAM ↗</a>
        </div>
        <div class="footer-col">
          <span class="footer-col-label">SEDE</span>
          <span>COLOMBIA</span>
          <span>2026</span>
        </div>
      </div>
    </footer>
  </div>
</section>

<style>
  .contacto-wrap {
    padding: 0 22px 22px;
  }

  .contacto-card {
    position: relative;
    overflow: hidden;
    background-color: var(--color-ink-800);
    color: var(--color-bg);
    border-radius: 34px;
    padding: 80px 60px 34px;
    display: flex;
    flex-direction: column;
    gap: 50px;
  }

  .contacto-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }

  .contacto-veil {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      180deg,
      rgba(22, 34, 27, 0.42) 0%,
      rgba(22, 34, 27, 0.6) 22%,
      rgba(22, 34, 27, 0.78) 48%,
      rgba(22, 34, 27, 0.9) 72%,
      rgba(22, 34, 27, 0.95) 100%
    );
  }

  .contacto-glow {
    position: absolute;
    top: -160px;
    left: 50%;
    transform: translateX(-50%);
    width: 620px;
    height: 620px;
    border-radius: var(--radius-full);
    background: radial-gradient(circle, rgba(133, 160, 147, 0.32) 0%, transparent 66%);
  }

  .head {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
  }

  .head-title {
    margin: 0;
    font-size: clamp(34px, 5.4vw, 76px);
    line-height: 0.94;
    letter-spacing: -0.045em;
    font-weight: 500;
    max-width: 20ch;
  }

  :global(.contacto-cta) {
    white-space: nowrap;
  }

  .footer-row {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-top: 28px;
    border-top: 1px solid rgba(237, 239, 233, 0.2);
  }

  .footer-logo {
    height: 44px;
    width: auto;
  }

  .footer-cols {
    display: flex;
    gap: 52px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--color-ondark-muted);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .footer-col-label {
    color: var(--color-ondark-faint);
  }

  @media (max-width: 1024px) {
    .contacto-wrap {
      padding-left: 16px;
      padding-right: 16px;
    }

    .contacto-card {
      padding: 44px 30px;
    }

    .head {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }

    :global(.contacto-cta) {
      align-self: flex-end;
    }

    .footer-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 26px;
    }

    .footer-cols {
      flex-wrap: wrap;
      gap: 22px 34px;
    }
  }

  @media (max-width: 640px) {
    .contacto-wrap {
      padding-left: 12px;
      padding-right: 12px;
    }

    .contacto-card {
      padding: 32px 20px;
      border-radius: 24px;
    }

    :global(.contacto-cta) {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }
</style>
