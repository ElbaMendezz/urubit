---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  image: ImageMetadata;
  width: number;
  height: number;
  label: string;
  caption: string;
}

const { href, image, width, height, label, caption } = Astro.props;
---

<a href={href} target="_blank" rel="noopener" class="reel" data-rv="1">
  <Image
    src={image}
    alt={caption}
    width={width}
    height={height}
    widths={[180, 235]}
    sizes="(max-width: 1024px) 50vw, 25vw"
    loading="lazy"
    class="reel-bg"
  />
  <div class="reel-veil"></div>
  <span class="reel-label">{label}</span>
  <div class="reel-play">▶</div>
  <span class="reel-caption">{caption}</span>
</a>

<style>
  .reel {
    position: relative;
    aspect-ratio: 9 / 16;
    background-color: var(--color-reel-fallback);
    border-radius: 200px 200px 18px 18px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: 26px 18px 18px;
    text-align: center;
  }

  .reel-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .reel-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(22, 34, 27, 0.55) 0%,
      rgba(22, 34, 27, 0.1) 38%,
      rgba(22, 34, 27, 0.78) 100%
    );
  }

  .reel:hover .reel-veil {
    background: linear-gradient(
      180deg,
      rgba(22, 34, 27, 0.35) 0%,
      rgba(22, 34, 27, 0.05) 38%,
      rgba(22, 34, 27, 0.7) 100%
    );
  }

  .reel-label {
    position: relative;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--color-reel-label);
  }

  .reel-play {
    position: relative;
    width: 50px;
    height: 50px;
    background: var(--color-accent);
    color: var(--color-ink-900);
    border-radius: var(--radius-full);
    display: grid;
    place-items: center;
    font-size: 13px;
  }

  .reel-caption {
    position: relative;
    font-size: 15px;
    line-height: 1.3;
    color: var(--color-reel-caption);
  }

  @media (max-width: 640px) {
    .reel {
      border-radius: 120px 120px 14px 14px;
      padding: 18px 12px 14px;
    }
  }
</style>
