---
interface Props {
  value: string;
  label: string;
  background: string;
  color?: string;
}

const { value, label, background, color = 'var(--color-ink-900)' } = Astro.props;
---

<div class="stat-card">
  <div class="stat-top">
    <slot name="icon" />
    <span class="stat-value" data-count={value}>{value}</span>
  </div>
  <span class="stat-label">{label}</span>
</div>

<style define:vars={{ statBg: background, statColor: color }}>
  .stat-card {
    background: var(--statBg);
    color: var(--statColor);
    border-radius: 20px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .stat-top {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .stat-value {
    font-size: 52px;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.9;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
  }
</style>
