---
interface Props {
  href: string;
  target?: '_blank';
  rel?: string;
  background: string;
  color: string;
  hoverBackground: string;
  hoverColor: string;
  fontSize: string;
  padding: string;
  fullWidth?: boolean;
  class?: string;
}

const {
  href,
  target,
  rel,
  background,
  color,
  hoverBackground,
  hoverColor,
  fontSize,
  padding,
  fullWidth = false,
  class: className,
} = Astro.props;
---

<a
  href={href}
  target={target}
  rel={rel}
  class:list={['cta', { 'cta--full': fullWidth }, className]}
>
  <slot />
</a>

<style
  define:vars={{
    ctaBg: background,
    ctaColor: color,
    ctaHoverBg: hoverBackground,
    ctaHoverColor: hoverColor,
    ctaFontSize: fontSize,
    ctaPadding: padding,
  }}
>
  .cta {
    background: var(--ctaBg);
    color: var(--ctaColor);
    border-radius: var(--radius-full);
    font-size: var(--ctaFontSize);
    padding: var(--ctaPadding);
  }

  .cta:hover {
    background: var(--ctaHoverBg);
    color: var(--ctaHoverColor);
  }

  .cta--full {
    display: block;
    text-align: center;
  }
</style>
